+    written = qemu_chr_fe_write(&s->chr, &s->tx_shift, 1);
+    if (written == 0 || (written < 0 && errno == EAGAIN)) {
+        assert(!s->tx_watch);
+        s->tx_watch = qemu_chr_fe_add_watch(&s->chr, G_IO_OUT | G_IO_HUP,
+                                           pl011_tx_watch, s);
+        if (s->tx_watch) {
+            /* One completed frame waits in the shift register. Never block
+             * the main loop or turn host backpressure into a guest CTS edge.
+             */
+            s->tx_backend_pending = true;
+            return;
+        }
+        /* An absent/disconnected backend is an unconnected serial wire. */
+    }
+    s->tx_backend_pending = false;
+    if (was_pending) {
+        /* Do not burst subsequent frames at stale, already elapsed dates. */
+        when = MAX(when, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    }
