+/*
+ * The RP1 profile uses the PL011 programmed RX thresholds and a timeout of
+ * 32 baud periods. Legacy boards retain their original wire/profile policy.
+ */
+static void pl011_rx_timeout_update(PL011State *s, bool restart)
+{
+    uint64_t hz, duration;
+    bool enabled = (s->cr & (CR_UARTEN | CR_RXE)) == (CR_UARTEN | CR_RXE);
+
+    if (!s->accurate_rx) {
+        return;
+    }
+    if (!s->read_count) {
+        s->int_level &= ~INT_RT;
+        pl011_update(s);
+    }
+    hz = clock_get_hz(s->clk);
+    if (!enabled || !s->read_count || !(s->rx_divisor >> 6) || !hz ||
+        (s->int_level & INT_RT)) {
+        timer_del(s->rx_timer);
+        return;
+    }
+    if (!restart && timer_pending(s->rx_timer)) {
+        return;
+    }
+    /*
+     * baud = 4 * uartclk / (64 * IBRD + FBRD).
+     * Round up so an interrupt never arrives before the 32nd bit period.
+     */
+    duration = DIV_ROUND_UP(8ULL * s->rx_divisor * 1000000000ULL, hz);
+    timer_mod(s->rx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + duration);
+}
+
+static void pl011_rx_timeout(void *opaque)
+{
+    PL011State *s = opaque;
+
+    if (s->accurate_rx && s->read_count &&
+        (s->cr & (CR_UARTEN | CR_RXE)) == (CR_UARTEN | CR_RXE)) {
+        s->int_level |= INT_RT;
+        pl011_update(s);
+    }
+}
