+    bool pending;
+
+    if (s->cqhci_capable) {
+        if (s->cqhci_irq && (s->norintstsen & (1u << 14))) {
+            s->norintsts |= 1u << 14;
+        } else {
+            s->norintsts &= ~(1u << 14);
+        }
+    }
+    pending = sdhci_slotint(s);
     qemu_set_irq(s->irq, pending);
 
     return pending;
+}
+
+/* CQHCI's interrupt source is separate from its SDHCI status/signal masks. */
+static void sdhci_cqhci_irq(void *opaque, int n, int level)
+{
+    SDHCIState *s = opaque;
+    s->cqhci_irq = level;
+    sdhci_update_irq(s);
 }
 
