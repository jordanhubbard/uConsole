+/* IRQs arise on a FIFO crossing, not merely from enabling an empty UART. */
+static unsigned pl011_tx_trigger(PL011State *s)
+{
+    static const unsigned eighths[] = {1, 2, 4, 6, 7};
+    unsigned selection = s->ifl & 7;
+
+    if (!pl011_is_fifo_enabled(s)) {
+        return 0;
+    }
+    return selection < ARRAY_SIZE(eighths) ?
+        s->fifo_depth * eighths[selection] / 8 : s->fifo_depth;
+}
+
+static void pl011_tx_update(PL011State *s, unsigned previous_count)
+{
+    unsigned trigger = pl011_tx_trigger(s);
+
+    s->flags &= ~(PL011_FLAG_TXFF | PL011_FLAG_TXFE | PL011_FLAG_BUSY);
+    if (!s->tx_count) {
+        s->flags |= PL011_FLAG_TXFE;
+    }
+    if (s->tx_count == pl011_get_fifo_depth(s)) {
+        s->flags |= PL011_FLAG_TXFF;
+    }
+    if (s->tx_count || s->tx_active) {
+        s->flags |= PL011_FLAG_BUSY;
+    }
+    if (s->tx_count > trigger) {
+        s->int_level &= ~INT_TX;
+    } else if (previous_count > trigger) {
+        s->int_level |= INT_TX;
+    }
+    pl011_update(s);
+}
