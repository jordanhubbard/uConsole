+static void pl011_tx_start(PL011State *s, int64_t when)
+{
+    uint64_t hz = clock_get_hz(s->clk);
+    uint64_t duration;
+    unsigned data_bits, frame_bits, previous_count;
+
+    if (!s->accurate_tx || s->tx_active || !s->tx_count ||
+        (s->cr & (CR_UARTEN | CR_TXE)) != (CR_UARTEN | CR_TXE) ||
+        ((s->cr & CR_CTSEN) && !(s->flags & PL011_FLAG_CTS)) ||
+        (s->lcr & LCR_BRK) || !hz || !(s->rx_divisor >> 6) ||
+        (s->rx_divisor > (IBRD_MASK << 6))) {
+        return;
+    }
+    data_bits = 5 + ((s->lcr >> 5) & 3);
+    frame_bits = 1 + data_bits + ((s->lcr & 2) != 0) +
+                 ((s->lcr & 8) ? 2 : 1);
+    duration = DIV_ROUND_UP(frame_bits * (uint64_t)s->rx_divisor *
+                           1000000000ULL, 4 * hz);
+    previous_count = s->tx_count--;
+    s->tx_shift = s->tx_fifo[s->tx_pos] & ((1U << data_bits) - 1);
+    s->tx_pos = (s->tx_pos + 1) & 31;
+    s->tx_active = true;
+    s->tx_loopback = pl011_loopback_enabled(s);
+    s->tx_rx_active = (s->cr & (CR_UARTEN | CR_RXE)) ==
+                     (CR_UARTEN | CR_RXE);
+    s->tx_deadline = when + duration;
+    timer_mod(s->tx_timer, s->tx_deadline);
+    pl011_tx_update(s, previous_count);
+}
